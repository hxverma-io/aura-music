# ==============================================================================
# Aura Music v1.0 — Environment Configuration Template
# ==============================================================================
# Copy this file to .env before running the project in production:
# cp .env.example .env

# Server Port
PORT=3001

# JWT Secret for Session Authentication (Change this in production to a random 64-char string)
JWT_SECRET=aura_music_super_secure_jwt_secret_key_2026_change_in_production

# Frontend API URL (leave empty in local dev to use Vite proxy or specify production API endpoint)
VITE_API_URL=http://localhost:3001/api

# Node Environment
NODE_ENV=development
